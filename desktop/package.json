{
  "name": "yike-ai-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.cjs",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "package:dev": "electron-forge package",
    "dev": "vite --config vite.renderer.config.ts",
    "build": "npm run typecheck && npm run build:renderer",
    "make": "electron-forge make",
    "make:mac": "electron-forge make --platform=darwin --arch=arm64",
    "make:win": "electron-forge make --platform=win32 --arch=x64"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "electron-squirrel-startup": "1.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "electron": "43.4.1",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "description": "意客AI商机工作台桌面客户端",
  "author": {
    "name": "Xinghe Technology"
  },
  "overrides": {
    "tar": "7.5.22",
    "tmp": "0.2.7"
  }
}
