@@ -0,0 +1,100 @@
+import json
+import os
+from pathlib import Path
+
+
+class YikePlatformAuthRequired(Exception):
+    pass
+
+
+class YikePlatformPermissionDenied(Exception):
+    pass
+
+
+class YikePlatformVerificationRequired(Exception):
+    pass
+
+
+class YikePlatformRateLimited(Exception):
+    pass
+
+
+class YikePlatformResponseChanged(Exception):
+    pass
+
+
+class YikeNetworkFailed(Exception):
+    pass
+
+
+class YikeCollectionParseFailed(Exception):
+    pass
+
+
+_EXPLICIT_TERMINALS = (
+    (YikePlatformAuthRequired, ("PLATFORM_AUTH_REQUIRED", 40)),
+    (YikePlatformPermissionDenied, ("PLATFORM_PERMISSION_DENIED", 41)),
+    (YikePlatformVerificationRequired, ("PLATFORM_VERIFICATION_REQUIRED", 42)),
+    (YikePlatformRateLimited, ("PLATFORM_RATE_LIMITED", 43)),
+    (YikePlatformResponseChanged, ("PLATFORM_RESPONSE_CHANGED", 44)),
+    (YikeNetworkFailed, ("COLLECTION_NETWORK_FAILED", 45)),
+    (YikeCollectionParseFailed, ("COLLECTION_PARSE_FAILED", 46)),
+)
+_progress_sequence = 0
+
+
+def classify_error(error: BaseException) -> tuple[str, int]:
+    for error_type, terminal in _EXPLICIT_TERMINALS:
+        if isinstance(error, error_type):
+            return terminal
+    if isinstance(error, TimeoutError):
+        return "COLLECTION_NETWORK_FAILED", 45
+    return "COLLECTION_PROCESS_FAILED", 48
+
+
+def _write_atomic(output_dir: str, name: str, payload: dict[str, object]) -> None:
+    directory = Path(output_dir)
+    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
+    target = directory / name
+    temporary = directory / f"{name}.tmp"
+    temporary.write_text(
+        json.dumps(payload, ensure_ascii=False, sort_keys=True),
+        encoding="utf-8",
+    )
+    temporary.chmod(0o600)
+    os.replace(temporary, target)
+
+
+def write_progress(output_dir: str, platform: str, state: str) -> None:
+    global _progress_sequence
+    if state not in {"WAITING_LOGIN", "RUNNING"}:
+        raise ValueError("invalid governed progress state")
+    _progress_sequence += 1
+    _write_atomic(
+        output_dir,
+        ".yike-collection-progress.json",
+        {
+            "schema_version": "YIKE_MEDIACRAWLER_PROGRESS_V1",
+            "platform": platform,
+            "state": state,
+            "sequence": _progress_sequence,
+        },
+    )
+
+
+def write_terminal(
+    output_dir: str,
+    platform: str,
+    status: str,
+    error_code: str | None,
+) -> None:
+    _write_atomic(
+        output_dir,
+        ".yike-collection-status.json",
+        {
+            "schema_version": "YIKE_MEDIACRAWLER_STATUS_V1",
+            "platform": platform,
+            "status": status,
+            "error_code": error_code,
+        },
+    )
