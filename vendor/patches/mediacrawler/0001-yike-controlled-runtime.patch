diff --git a/tools/yike_runtime.py b/tools/yike_runtime.py
new file mode 100644
index 0000000..2fdbbaf
--- /dev/null
+++ b/tools/yike_runtime.py
@@ -0,0 +1,168 @@
+import json
+import os
+from pathlib import Path
+
+class YikePlatformAuthRequired(Exception):
+    pass
+
+
+class YikePlatformPermissionDenied(Exception):
+    pass
+
+
+class YikePlatformVerificationRequired(Exception):
+    pass
+
+
+class YikePlatformRateLimited(Exception):
+    pass
+
+
+class YikePlatformResponseChanged(Exception):
+    pass
+
+
+class YikeNetworkFailed(Exception):
+    pass
+
+
+class YikeCollectionParseFailed(Exception):
+    pass
+
+
+_EXPLICIT_TERMINALS = (
+    (YikePlatformAuthRequired, ("PLATFORM_AUTH_REQUIRED", 40)),
+    (YikePlatformPermissionDenied, ("PLATFORM_PERMISSION_DENIED", 41)),
+    (YikePlatformVerificationRequired, ("PLATFORM_VERIFICATION_REQUIRED", 42)),
+    (YikePlatformRateLimited, ("PLATFORM_RATE_LIMITED", 43)),
+    (YikePlatformResponseChanged, ("PLATFORM_RESPONSE_CHANGED", 44)),
+    (YikeNetworkFailed, ("COLLECTION_NETWORK_FAILED", 45)),
+    (YikeCollectionParseFailed, ("COLLECTION_PARSE_FAILED", 46)),
+)
+_progress_sequence = 0
+
+
+def classify_error(error: BaseException) -> tuple[str, int]:
+    for error_type, terminal in _EXPLICIT_TERMINALS:
+        if isinstance(error, error_type):
+            return terminal
+    try:
+        from playwright.async_api import TimeoutError as PlaywrightTimeoutError
+    except ImportError:
+        is_playwright_timeout = False
+    else:
+        is_playwright_timeout = isinstance(error, PlaywrightTimeoutError)
+    if isinstance(error, TimeoutError) or is_playwright_timeout:
+        return "COLLECTION_NETWORK_FAILED", 45
+    return "COLLECTION_PROCESS_FAILED", 48
+
+
+def _required_field(value: object, field: str) -> object:
+    if not isinstance(value, dict) or field not in value:
+        raise YikePlatformResponseChanged()
+    return value[field]
+
+
+def require_mapping_field(value: object, field: str) -> dict:
+    field_value = _required_field(value, field)
+    if type(field_value) is not dict:
+        raise YikePlatformResponseChanged()
+    return field_value
+
+
+def require_list_field(value: object, field: str) -> list:
+    field_value = _required_field(value, field)
+    if type(field_value) is not list:
+        raise YikePlatformResponseChanged()
+    return field_value
+
+
+def require_mapping_list_field(value: object, field: str) -> list[dict]:
+    field_value = require_list_field(value, field)
+    if any(type(item) is not dict for item in field_value):
+        raise YikePlatformResponseChanged()
+    return field_value
+
+
+def require_nonempty_string_field(value: object, field: str) -> str:
+    field_value = _required_field(value, field)
+    if type(field_value) is not str or not field_value:
+        raise YikePlatformResponseChanged()
+    return field_value
+
+
+def require_int_field(value: object, field: str) -> int:
+    field_value = _required_field(value, field)
+    if type(field_value) is not int:
+        raise YikePlatformResponseChanged()
+    return field_value
+
+
+def require_bilibili_comment_list(value: object, field: str) -> list[dict]:
+    comments = require_mapping_list_field(value, field)
+    for comment in comments:
+        if require_int_field(comment, "rpid") <= 0:
+            raise YikePlatformResponseChanged()
+    return comments
+
+
+def require_douyin_comment_list(value: object, field: str) -> list[dict]:
+    comments = require_mapping_list_field(value, field)
+    for comment in comments:
+        require_nonempty_string_field(comment, "cid")
+    return comments
+
+
+def require_bool_field(value: object, field: str) -> bool:
+    field_value = _required_field(value, field)
+    if type(field_value) is not bool:
+        raise YikePlatformResponseChanged()
+    return field_value
+
+
+def _write_atomic(output_dir: str, name: str, payload: dict[str, object]) -> None:
+    directory = Path(output_dir)
+    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
+    target = directory / name
+    temporary = directory / f"{name}.tmp"
+    temporary.write_text(
+        json.dumps(payload, ensure_ascii=False, sort_keys=True),
+        encoding="utf-8",
+    )
+    temporary.chmod(0o600)
+    os.replace(temporary, target)
+
+
+def write_progress(output_dir: str, platform: str, state: str) -> None:
+    global _progress_sequence
+    if state not in {"WAITING_LOGIN", "RUNNING"}:
+        raise ValueError("invalid governed progress state")
+    _progress_sequence += 1
+    _write_atomic(
+        output_dir,
+        ".yike-collection-progress.json",
+        {
+            "schema_version": "YIKE_MEDIACRAWLER_PROGRESS_V1",
+            "platform": platform,
+            "state": state,
+            "sequence": _progress_sequence,
+        },
+    )
+
+
+def write_terminal(
+    output_dir: str,
+    platform: str,
+    status: str,
+    error_code: str | None,
+) -> None:
+    _write_atomic(
+        output_dir,
+        ".yike-collection-status.json",
+        {
+            "schema_version": "YIKE_MEDIACRAWLER_STATUS_V1",
+            "platform": platform,
+            "status": status,
+            "error_code": error_code,
+        },
+    )
