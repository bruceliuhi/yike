@@ -70,0 +74,49 @@ crawler: Optional[AbstractCrawler] = None
+STATUS_SCHEMA = "YIKE_MEDIACRAWLER_STATUS_V1"
+
+
+def _terminal_for(error: Exception) -> tuple[str, int]:
+    message = str(error).lower()
+    if "yike_platform_auth_required" in message:
+        return "PLATFORM_AUTH_REQUIRED", 40
+    if "yike_platform_verification_required" in message or "captcha" in message:
+        return "PLATFORM_VERIFICATION_REQUIRED", 42
+    if any(token in message for token in ("rate", "429", "风控", "blocked", "频繁")):
+        return "PLATFORM_RATE_LIMITED", 43
+    if any(token in message for token in ("permission", "403", "权限", "拒绝")):
+        return "PLATFORM_PERMISSION_DENIED", 41
+    if "response" in message or "decode" in message or "json" in message:
+        return "PLATFORM_RESPONSE_CHANGED", 44
+    if "network" in message or "timeout" in message or "connect" in message:
+        return "COLLECTION_NETWORK_FAILED", 45
+    return "COLLECTION_PROCESS_FAILED", 48
+
+
+def _write_terminal(status: str, error_code: str | None) -> None:
+    output_dir = Path(config.SAVE_DATA_PATH)
+    output_dir.mkdir(parents=True, exist_ok=True)
+    target = output_dir / ".yike-collection-status.json"
+    temporary = target.with_suffix(".tmp")
+    temporary.write_text(
+        json.dumps(
+            {
+                "schema_version": STATUS_SCHEMA,
+                "platform": config.PLATFORM,
+                "status": status,
+                "error_code": error_code,
+            },
+            ensure_ascii=False,
+            sort_keys=True,
+        ),
+        encoding="utf-8",
+    )
+    os.replace(temporary, target)
+
+
+def _has_comment_output() -> bool:
+    platform_dir = "bili" if config.PLATFORM == "bili" else "douyin"
+    data_dir = Path(config.SAVE_DATA_PATH) / platform_dir / "jsonl"
+    for path in data_dir.glob("search_comments_*.jsonl"):
+        with path.open(encoding="utf-8") as source:
+            if any(line.strip() for line in source):
+                return True
+    return False
@@ -103,18 +155,24 @@ async def main() -> None:
-    args = await cmd_arg.parse_cmd()
-    if args.init_db:
-        await db.init_db(args.init_db)
-        print(f"Database {args.init_db} initialized successfully.")
-        return
-
-    # 数据库保存模式下自动建表，避免首次运行时出现 no such table 错误
-    if config.SAVE_DATA_OPTION in ("sqlite", "mysql", "db", "postgres"):
-        await db.init_db(config.SAVE_DATA_OPTION)
-
-    crawler = CrawlerFactory.create_crawler(platform=config.PLATFORM)
-    await crawler.start()
-
-    _flush_excel_if_needed()
-
-    # Generate wordcloud after crawling is complete
-    # Only for JSON save mode
-    await _generate_wordcloud_if_needed()
+    try:
+        args = await cmd_arg.parse_cmd()
+        if args.init_db:
+            await db.init_db(args.init_db)
+            print(f"Database {args.init_db} initialized successfully.")
+            return
+
+        if config.SAVE_DATA_OPTION in ("sqlite", "mysql", "db", "postgres"):
+            await db.init_db(config.SAVE_DATA_OPTION)
+
+        crawler = CrawlerFactory.create_crawler(platform=config.PLATFORM)
+        await crawler.start()
+        _flush_excel_if_needed()
+        await _generate_wordcloud_if_needed()
+        _write_terminal(
+            "SUCCEEDED" if _has_comment_output() else "SUCCEEDED_NO_DATA", None
+        )
+    except asyncio.CancelledError:
+        _write_terminal("CANCELLED", "COLLECTION_CANCELLED")
+        raise SystemExit(47)
+    except Exception as error:
+        error_code, return_code = _terminal_for(error)
+        _write_terminal("BLOCKED_INPUT" if return_code in {40, 41, 42, 43} else "FAILED", error_code)
+        raise SystemExit(return_code) from error
