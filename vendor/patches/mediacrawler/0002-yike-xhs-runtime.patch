+def _xhs_time(value):
+    """Upstream XHS publication fields are milliseconds; unknown stays null."""
+    if value is None:
+        return None
+    if type(value) is not int or value < 0:
+        raise YikePlatformResponseChanged()
+    try:
+        return datetime.fromtimestamp(value // 1000, timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")
+    except (ValueError, OverflowError, OSError):
+        raise YikePlatformResponseChanged() from None
